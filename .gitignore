# Python/Backend ignores
__pycache__/
*.py[cod]
*$py.class
.venv/
.env
audio/
logs/
*.log
*.db
*.mp3
*.wav
*.txt
# ...except the backend's own dependency/build files, which *.txt above
# would otherwise silently exclude from every commit.
!backend/requirements.txt
!backend/constraints.txt
# ...and the root-level files Hugging Face Spaces' Gradio SDK build reads
# (requirements.txt, packages.txt, runtime.txt) — see app.py.
!/requirements.txt
!/packages.txt
!/runtime.txt

# Node/Frontend ignores
node_modules/
dist/
.DS_Store
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE/System ignores
.gemini/
.idea/
.vscode/
