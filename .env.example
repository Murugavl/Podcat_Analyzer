WHISPER_MODEL_SIZE=base
MAX_UPLOAD_SIZE_MB=100
AUDIO_TEMP_DIR=audio
LOG_FILE=logs/podcast_analyzer.log
ALLOWED_ORIGINS=http://localhost:5173

# Cross-origin cookie settings. Keep the defaults for local dev. In
# production (frontend on Vercel, backend on Render — different domains),
# set COOKIE_SAMESITE=none and COOKIE_SECURE=true, or the session cookie
# won't be sent on cross-site requests.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
