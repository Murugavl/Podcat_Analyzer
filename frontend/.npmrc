# lucide-react@0.363.0's peer range tops out at React 18, but this project
# is on React 19 — legacy-peer-deps skips that check instead of failing the
# install. Needed on any platform that runs a plain `npm install`/`npm ci`
# (Vercel included); the Dockerfile used to pass this as a CLI flag, now
# redundant but harmless since this file covers it too.
legacy-peer-deps=true
